# Docker (docker compose up -d):
DATABASE_URL="postgresql://fintrack:fintrack-local@localhost:5433/fintrack?schema=public"
TEST_DATABASE_URL="postgresql://fintrack:fintrack-local@localhost:5433/fintrack_test?schema=public"
# Or a locally installed Postgres:
# DATABASE_URL="postgresql://USER@localhost:5432/fintrack?schema=public"
APP_PASSWORD="choose-a-strong-password"
SESSION_SECRET="output-of: openssl rand -hex 32"
# Optional
# APP_USER_EMAIL="owner@fintrack.local"
# APP_USER_NAME="Your name"
